# Drone Wi-Fi router settings, built into the ESP32 firmware by scripts/flash-drone.ps1.
#
# How to use: copy this file to config/drone-wifi.env (gitignored, because it holds the password;
# flash-drone.ps1 does the copy the first time) and edit THAT file, not this one.
# Get the router's name and password from whoever set up the router (or the router's label).
# The ESP32 only learns a new name/password when it is re-flashed.
#
# The router must hand out the 192.168.1.x range with itself at 192.168.1.1 (the firmware gives
# drone N the fixed IP 192.168.1.(200+N) and sends telemetry to the laptop at 192.168.1.(100+N)).
# Use the router's 2.4 GHz network: the ESP32 has no 5 GHz radio.

WIFI_SSID=CHANGE-ME-router-name
WIFI_PASSWORD=CHANGE-ME-router-password
WIFI_GATEWAY=192.168.1.1
WIFI_NETMASK=255.255.255.0
